<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:TelltaleModLauncher.Views"
        x:Class="TelltaleModLauncher.Views.ModDetailsWindow"
        Title="Mod details"
        Width="860" Height="580" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="28,24">
    <StackPanel Spacing="4">
      <TextBlock x:Name="Heading" Classes="display" FontSize="30" TextWrapping="Wrap" />
      <TextBlock x:Name="Byline" Classes="muted" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,18,0,18">
      <StackPanel Spacing="2">
        <TextBlock Classes="section" Text="MADE FOR" />
        <TextBlock x:Name="MadeFor" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="2" Margin="16,0">
        <TextBlock Classes="section" Text="PRIORITY" />
        <TextBlock x:Name="Priority" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="2">
        <TextBlock Classes="section" Text="INFO FILE" />
        <TextBlock x:Name="InfoFile" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="300,*">
      <Border Classes="card" Padding="6">
        <ListBox x:Name="Files" Classes="files" AutomationProperties.Name="Mod files">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="v:ModFileItem">
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Border Grid.Column="1" Classes="card" Margin="12,0,0,0">
        <Panel>
          <ScrollViewer x:Name="PreviewScroll" IsVisible="False">
            <SelectableTextBlock x:Name="Preview" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="16" TextWrapping="Wrap" />
          </ScrollViewer>
          <TextBlock x:Name="PreviewHint" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" Margin="32"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Text="Select a text file to read it here." />
        </Panel>
      </Border>
    </Grid>

    <Button Grid.Row="3" Classes="outline" Content="Close" HorizontalAlignment="Right" Margin="0,18,0,0" IsCancel="True" Click="OnClose" />
  </Grid>
</Window>
